# 印章 API 是可选增强项；不配置时使用本地 macOS Vision。
SEAL_API_URL=https://seal.qingtong.cn
SEAL_API_KEY=
SEAL_API_TIMEOUT=120

APP_HOST=127.0.0.1
APP_PORT=5000
FLASK_DEBUG=0

# 单证通默认真实生产接入，网络直连；环境变量覆盖 config/danzhengtong.local.json。
DZT_MODE=real
DZT_BASE_URL=https://api.sinotrans.com
DZT_APP_ID=
DZT_APP_KEY=
DZT_APP_SECRET=
DZT_KEY_ID=
DZT_CALLBACK_URL=http://172.30.197.3:10000/OcrPlugins/customsOcr/testNotify
DZT_SYS_CODE=LOGISTICS_SAMSUNG
DZT_ORG_ID=101517
DZT_MODEL_ID=logistics_samsung_deliverynote_1503

# 文件服务器采用 multipart 上传；source_code 默认复用 DZT_SYS_CODE。
DZT_UPLOAD_URL=http://techfile.i.sinotrans.com:80/objectstorecloud/files/v2
DZT_UPLOAD_SOURCE_CODE=

# 每隔 2 秒查询一次，默认等待结果上限 300 秒。
DZT_POLL_TIMEOUT_SECONDS=60
